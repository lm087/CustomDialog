<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item android:gravity="bottom" android:height="1dp" android:bottom="4dp">
                <shape><solid android:color="@color/divider" /></shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item android:gravity="bottom" android:height="2dp" android:bottom="4dp">
                <shape><solid android:color="?android:attr/colorAccent" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:gravity="bottom" android:height="1dp" android:bottom="4dp">
                <shape><solid android:color="@color/text_secondary" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
